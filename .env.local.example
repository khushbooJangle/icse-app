# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — the real keys never get committed.
# See supabase/SETUP.md step 2 for where to find these in the dashboard.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> anon / public key (newer dashboards: "publishable")
# Safe to expose in the browser: it identifies the project, not the user.
# Row Level Security is what actually protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER put the service_role key in this file. Anything prefixed NEXT_PUBLIC_
# is bundled into the browser, and service_role bypasses every RLS policy.
